# Copy to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://agrisense:agrisense@localhost:5432/agrisense
CELERY_BROKER_URL=redis://localhost:6379/0

# Kindwise crop.health — get a key at https://admin.kindwise.com (100 free credits)
DIAGNOSIS_PROVIDER=kindwise
KINDWISE_API_KEY=
KINDWISE_LANGUAGE=en
DIAGNOSIS_TOP_N=3
