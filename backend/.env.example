# Copy to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://agrisense:agrisense@localhost:5432/agrisense
CELERY_BROKER_URL=redis://localhost:6379/0

# Kindwise crop.health â€” get a key at https://admin.kindwise.com (100 free credits)
DIAGNOSIS_PROVIDER=kindwise
KINDWISE_API_KEY=
KINDWISE_LANGUAGE=en
DIAGNOSIS_TOP_N=3

# Cache (Redis in production so all workers share the M-Pesa token)
CACHE_URL=locmemcache://

# M-Pesa Daraja — sandbox app at https://developer.safaricom.co.ke (test shortcode 174379)
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=174379
# Public HTTPS URL Safaricom can reach, e.g. https://abc123.ngrok-free.app
MPESA_CALLBACK_BASE_URL=
# Long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(32))"
MPESA_CALLBACK_TOKEN=

# OCR.space — free key at https://ocr.space/ocrapi/freekey
OCRSPACE_API_KEY=
