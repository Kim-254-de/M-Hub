# Copy to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://agrisense:agrisense@localhost:5432/agrisense
CELERY_BROKER_URL=redis://localhost:6379/0

# Kindwise crop.health — get a key at https://admin.kindwise.com (100 free credits)
DIAGNOSIS_PROVIDER=kindwise
KINDWISE_API_KEY=
KINDWISE_LANGUAGE=en
DIAGNOSIS_TOP_N=3

# Mobile app login tokens
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# Detect photo checks (tune on real field photos)
DETECT_MIN_PHOTO_SIDE=480
DETECT_MIN_SHARPNESS=60
DETECT_MIN_BRIGHTNESS=40

# Diagnose: agrovet confirmation (defaults shown)
DIAGNOSE_SIMILAR_RADIUS_KM=15
DIAGNOSE_SIMILAR_WINDOW_DAYS=30
DIAGNOSE_SIMILAR_MIN_CASES=3
DIAGNOSE_AI_MIN_PROBABILITY=0.5
DIAGNOSE_AI_PROVISIONAL_MIN_PROBABILITY=0.5
DIAGNOSE_REVIEW_TIMEOUT_HOURS=24

# Prescribe (defaults shown)
PRESCRIBE_EXPIRY_DAYS=14
PRESCRIBE_MIN_LOCAL_OUTCOMES=5

# Follow-up (defaults shown)
FOLLOWUP_CLOSE_AFTER_DAYS=14
FOLLOWUP_REWARD_POINTS=5

# SMS: Africa's Talking. Sandbox key at https://account.africastalking.com (Sandbox app -> Settings -> API Key);
# messages show in https://simulator.africastalking.com. SMS is on when AT_API_KEY is set.
AT_USERNAME=sandbox
AT_API_KEY=
AT_BASE_URL=https://api.sandbox.africastalking.com
AT_SENDER_ID=
# Long random string for the delivery report URL
SMS_CALLBACK_TOKEN=

# Cache (Redis in production so all workers share the M-Pesa token)
CACHE_URL=locmemcache://

# M-Pesa Daraja — sandbox app at https://developer.safaricom.co.ke (test shortcode 174379)
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=174379
# Public HTTPS URL Safaricom can reach, e.g. https://abc123.ngrok-free.app
MPESA_CALLBACK_BASE_URL=
# Long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(32))"
MPESA_CALLBACK_TOKEN=

# OCR.space — free key at https://ocr.space/ocrapi/freekey
OCRSPACE_API_KEY=

# Advisory (Kikuyu crop advice). Gemini by default; set ADVISORY_PROVIDER=claude to use Claude instead.
# Use a key from a billing-enabled Google project for real farmer data: on the free tier Google may
# use prompts and answers to improve its products, and human reviewers may read them.
GEMINI_API_KEY=
ADVISORY_PROVIDER=gemini
ADVISORY_MODEL=gemini-3.8-flash
ADVISORY_EFFORT=medium
# Only for ADVISORY_PROVIDER=claude
ANTHROPIC_API_KEY=

# Accounts: sign-up needs an SMS code. false only for local development without SMS.
REQUIRE_OTP=true
# Shown in the app's settings ("Use WhatsApp instead"); empty hides it.
SUPPORT_WHATSAPP=
