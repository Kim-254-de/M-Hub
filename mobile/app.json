{
  "expo": {
    "name": "AgriSense",
    "slug": "agrisense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F5F2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ke.agrisense.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "AgriSense uses the camera to photograph your sick tomato plants and product labels.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "AgriSense records an optional voice note describing your crop problem.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AgriSense uses your farm location to find verified agrovets near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7EF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "scheme": "agrisense",
    "backgroundColor": "#FBF7EF",
    "experiments": {
      "typedRoutes": true
    }
  }
}
