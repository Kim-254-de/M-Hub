# Copy to .env and fill in. Never commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
# Needed for the admin login over https (ngrok / Render), comma-separated
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-subdomain.ngrok-free.app
# Leave empty to use SQLite locally; Render sets this to Postgres
DATABASE_URL=

# Public https address of this server (ngrok or Render), no trailing slash
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# --- WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup)
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_VERIFY_TOKEN=agrisense_verify_2026
WA_APP_SECRET=
WA_API_VERSION=v25.0
# web = browser chat at /chat/ ; cloud = real WhatsApp. Empty = web until WA_ACCESS_TOKEN is set
WA_TRANSPORT=
WA_ASYNC=true
WA_FOLLOWUP_TEMPLATE=treatment_followup
WA_FOLLOWUP_TEMPLATE_LANG=en

# --- crop.health (Kindwise). Empty = demo mode with a canned diagnosis
CROP_HEALTH_API_KEY=
DIAGNOSIS_REVIEW_THRESHOLD=0.5

# --- M-Pesa Daraja (developer.safaricom.co.ke). Sandbox shortcode/passkey shown on the Daraja test credentials page
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_TOKEN=pick-a-long-random-string

# Label check — free key at https://ocr.space/ocrapi/freekey (empty = type the PCPB number)
OCRSPACE_API_KEY=
